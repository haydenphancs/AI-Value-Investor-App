	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.phan.caydex.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>caydex</string>
			</array>
		</dict>
	</array>
	<!-- Public Supabase project URL, used only to build the OAuth authorize URL.
	     Not a secret: the anon key is deliberately NOT shipped in the app. -->
	<key>SupabaseURL</key>
	<string>https://gutlnhsjxrkxvrbqbbqq.supabase.co</string>
</dict>
