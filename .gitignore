# --- Book narration / voice-clone local artifacts (large + regenerable; never commit) ---
backend/venv_clone/
backend/data/book_audio/orig/
backend/data/book_audio/orig_speed/
backend/data/book_audio/.cache_*/
backend/data/book_audio/.clone_cache_*/
backend/data/book_audio/.tmp_*/
# Ignore voice_clone EXCEPT refs/ — everything else in there is a one-off audition render or a
# regenerable cache (~118 MB), but refs/ holds the reference clips that DEFINE the narration
# voices: caydex_voice_achird_v2.wav is the voice of every Money Moves article AND all 207
# Investor Journey cards. It cannot be regenerated — the clone is not reproducible without it —
# and ignoring it left the whole catalog's voice living on exactly one laptop. 6.5 MB total.
backend/data/voice_clone/*
!backend/data/voice_clone/refs/
# Transient staging for clone_learn_audio.py: clips land here, get voice-verified, then are
# MOVED into data/{money_moves,journey}_audio/ which are tracked. Committing the staging copy
# would double every clip in the repo and blur which dir is canonical.
backend/data/money_moves_audio_clone/
backend/data/journey_audio_clone/

# --- Book cover generation local artifacts (regenerable; never commit) ---
# The .art.jpg masters and the composited .hero/.thumb ARE committed: art generation is
# nondeterministic and paid, so a deleted master can never be recovered, only replaced
# with a different picture. Committing it is what makes re-typesetting runnable on a
# fresh clone with no API key. Only scratch is ignored.
backend/data/book_covers/.tmp_*
backend/data/book_covers/*.art.v*.jpg
backend/data/book_covers/*.candidates.jpg

# --- Money Moves art generation scratch (regenerable; never commit) ---
# Same rule as the book covers above: each slug's .art.jpg master, its .hero/.card
# derivatives AND its .manifest.json ARE committed. The manifest is load-bearing beyond
# reproducibility — seed_money_moves.py skips an upload on the derivative's sha256 recorded
# there, so losing it re-uploads every plate.
#
# ⚠️ Do NOT add *.subject.txt. generate_money_moves_art.resolve() READS it for any
# --auto-written article, which makes it an input to art_prompt_sha1 — ignoring it would
# silently re-roll that plate at full cost on a fresh clone.
#
# (gitignore has no inline comments — a trailing "# ..." becomes part of the pattern and
# silently matches nothing, so each note goes on its own line.)
#
# --compare bake-offs: one slug rendered across N treatments.
backend/data/money_moves_art/_compare/
# Superseded masters, archived automatically on EVERY re-roll. Without this rule each
# regeneration quietly adds another ~1 MB blob to history.
backend/data/money_moves_art/_prev/
# Orphaned 3:2 style bake-off from the pre-16:9 system. Nothing in the tree reads it.
backend/data/money_moves_art/_style/

dump.rdb

# Sentry CLI configuration file for Xcode
frontend/ios/ios/.sentryclirc

xcuserdata/
