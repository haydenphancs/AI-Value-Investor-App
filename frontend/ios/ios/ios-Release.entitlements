<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  RELEASE entitlements (TestFlight + App Store).

  Split from ios.entitlements because `aps-environment` must differ per configuration:
  a Debug build talks to the APNs sandbox, a distribution build talks to production, and
  the device token issued is only valid for the environment named here. One shared file
  cannot be correct for both — a `development` value in a TestFlight build makes every
  push silently fail.

  The backend already records which environment a token belongs to
  (`device_tokens.environment`) and routes accordingly, so the two sides agree.

  EVERY OTHER ENTITLEMENT MUST BE DUPLICATED HERE. Splitting the files means this one is not
  a delta over ios.entitlements — it REPLACES it for Release. `com.apple.developer.applesignin`
  was lost in that split, so Sign in with Apple worked in Debug and was absent from every
  TestFlight and App Store build: the capability fails at runtime in exactly the builds a
  developer cannot easily test, and Guideline 4.8 REQUIRES it once Google Sign-In ships.
  Add new capabilities to BOTH files.
-->
<plist version="1.0">
<dict>
	<!-- Sign in with Apple. REQUIRED by App Review 4.8 once Google Sign-In ships:
	     an app offering a third-party/social login must also offer a login service
	     that limits collection to name + email, lets the user keep their address
	     private, and does not track them for advertising. Mirrors ios.entitlements. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Duplicated from ios.entitlements, per the warning at the top of this file: Release
	     REPLACES Debug rather than extending it, and Sign in with Apple was already lost once
	     in that split. Passkeys and Password AutoFill would have failed in exactly the builds
	     hardest to test — TestFlight and App Store — with no signal. See ios.entitlements for
	     the full reasoning and the portal prerequisite. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:caydexinvest.com</string>
	</array>
	<!-- Time Sensitive Notifications. REQUIRED for the `price_alert` kind, which ships
	     `aps.interruption-level = "time-sensitive"` so a threshold the USER set themselves
	     breaks through Focus and Do Not Disturb. Every other kind is `active` or `passive`
	     and needs nothing here.

	     ⚠️ FAILS SILENTLY WITHOUT THIS. iOS does not error, log, or reject the push — it
	     just downgrades the level to `active`, so the notification arrives normally and is
	     suppressed by Focus exactly like a routine one. There is no runtime signal at all.

	     ⚠️ Requires the "Time Sensitive Notifications" capability on the App ID in the
	     Developer portal as well. The entitlement here is only half of it; a build signed
	     against a profile whose App ID lacks the capability FAILS TO SIGN.

	     Verify: iOS Settings › Notifications › Caydex shows a "Time Sensitive Notifications"
	     toggle ONLY when this entitlement is present in the installed build. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<key>aps-environment</key>
	<string>production</string>
	<!-- App Group — see the long note in ios.entitlements for why the widget reads a
	     snapshot instead of calling the API itself. Duplicated here because THIS FILE
	     REPLACES the Debug one rather than extending it; a capability that exists only
	     in Debug is absent from every shipped build. That has already happened once to
	     `applesignin`, which is why this file carries the warning at the top.

	     The identifier must be byte-identical here, in ios.entitlements, in the widget's
	     entitlements, and in the Swift constant. `test_ios_widget_parity.py` pins all
	     four. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.phan.caydex</string>
	</array>
</dict>
</plist>
