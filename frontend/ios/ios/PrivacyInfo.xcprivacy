<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PrivacyInfo.xcprivacy — Caydex

  REQUIRED TO UPLOAD. Since 1 May 2024 App Store Connect rejects binaries that use a
  "required reason API" without declaring it here. This is not a review judgement — the
  upload itself fails. The app had no manifest at all.

  Contents are derived from an audit of what the app actually collects, not from a
  template. Keep it in sync when adding an integration, an SDK, or a new stored field.

  Required-reason APIs (re-audited 2026-09-24; tests/test_ios_privacy_manifest_reasons.py
  now scans for them, so a new use fails the build instead of the upload):
    * UserDefaults — CA92.1 for the app's own defaults (@AppStorage, UserDefaults.standard)
      AND 1C8F.1 for the App Group suite `group.com.phan.caydex`, which the app writes via
      the Shared/ widget files (WidgetSnapshotStore, WidgetAPIConfig). CA92.1 alone
      does not cover App Group access.
    * File timestamp — C617.1. `LearnAudioCache` touches `.modificationDate` and reads
      `.contentModificationDateKey` on files inside its own Caches directory for LRU
      eviction. This line used to say "file-timestamp APIs verified ABSENT"; the cache
      arrived later and nobody re-ran the audit.
  Verified ABSENT: system boot time, disk space, and active-keyboard APIs.

  Tracking: false. There is no IDFA, no AppTrackingTransparency and no advertising SDK —
  grep for ATTrackingManager / advertisingIdentifier / NSUserTrackingUsageDescription
  returns nothing but this comment. Package.resolved has NINE pins: sentry-cocoa plus the
  GoogleSignIn dependency tree (googlesignin-ios, appauth-ios, gtmappauth,
  gtm-session-fetcher, googleutilities, app-check, promises, interop-ios-for-google-sdks).
  All nine ship their own manifests, and none is an advertising or attribution SDK, so the
  conclusion is unchanged — but do not restate the old "exactly one pin (sentry-cocoa)"
  rationale, which was already stale when the Google SDK landed.

  NOT declared, deliberately:
    * Performance Data — Sentry runs with tracesSampleRate = 0.0, so none is sent.
    * Precise/Coarse Location, Health, Contacts, Audio Data — all verified absent
      from the codebase.

  Photos or Videos IS declared, as of the Help Us Improve screen: the user may attach a
  screenshot to a bug report, which is emailed to support@. It is optional, user-initiated,
  and the image is visible in the composer before it sends. `PhotosPicker` runs out of
  process, so no NSPhotoLibraryUsageDescription is needed and no prompt is shown — but the
  DATA still reaches us, and that is what this key is about.
  `tests/test_ios_feedback_flow.py::test_photos_usage_and_the_privacy_filing_agree` fails
  the build if this and the code ever disagree, in either direction.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- CA92.1: @AppStorage throughout the app (settings, playback prefs, notification
			     toggles, the first-run disclaimer acknowledgement) — the app's OWN defaults.
			     1C8F.1: the App Group suite shared with CaydexWidgets (widget snapshot,
			     widget token, base-URL override), written by the Shared/ widget files. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
		<dict>
			<!-- C617.1: LearnAudioCache sets and reads modification dates on narration files
			     inside its own Caches directory to evict least-recently-used clips. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Account email, from sign-up / sign-in. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Optional display name on the profile. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Account user id. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Per-install identifier held in the Keychain and sent as X-Guest-Id on every
		     request. Used for abuse/cost rate limiting and to keep guest learning
		     progress. Hashed server-side; never used for advertising. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Chat messages typed by the user, report ratings, and written feedback. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Screenshot the user optionally attaches to a Help Us Improve bug report. It is
		     picked one image at a time via the out-of-process PhotosPicker, shown in the mail
		     composer before sending, and reaches us only because the user sends it. Never
		     scanned, never uploaded in the background, never used for anything else. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Self-reported holdings: share counts and position values the user types in
		     for the diversification score. No brokerage link, no account numbers, no
		     payment details. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherFinancialInfo</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Watchlist contents, lesson/book completion, bookmarks, followed entities. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- IAP purchase history. StoreKit 2 ships (StoreKitService, observer started at
		     launch), and every verified transaction is written to `credit_purchases` with a
		     NOT NULL user_id alongside transaction_id / product_id / price_cents — so it is
		     LINKED, not anonymous. Subscriptions additionally set users.tier. No card or
		     billing details ever reach us; Apple handles payment and we see only Apple's
		     signed transaction. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Crash reports via Sentry. NOT linked to identity: the SDK runs with
		     sendDefaultPii = false and SentrySDK.setUser is never called. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Search picks (a tap on a search RESULT row) for the "Trending searches" chips.
		     NOT linked to identity: the server keeps only an anonymous daily count per
		     ticker (search_pick_daily, migration 179) — no user, device or IP column. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeSearchHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
