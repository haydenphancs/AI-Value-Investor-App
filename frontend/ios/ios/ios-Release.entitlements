<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  RELEASE entitlements (TestFlight + App Store).

  Split from ios.entitlements because `aps-environment` must differ per configuration:
  a Debug build talks to the APNs sandbox, a distribution build talks to production, and
  the device token issued is only valid for the environment named here. One shared file
  cannot be correct for both — a `development` value in a TestFlight build makes every
  push silently fail.

  The backend already records which environment a token belongs to
  (`device_tokens.environment`) and routes accordingly, so the two sides agree.

  EVERY OTHER ENTITLEMENT MUST BE DUPLICATED HERE. Splitting the files means this one is not
  a delta over ios.entitlements — it REPLACES it for Release. `com.apple.developer.applesignin`
  was lost in that split, so Sign in with Apple worked in Debug and was absent from every
  TestFlight and App Store build: the capability fails at runtime in exactly the builds a
  developer cannot easily test, and Guideline 4.8 REQUIRES it once Google Sign-In ships.
  Add new capabilities to BOTH files.
-->
<plist version="1.0">
<dict>
	<!-- Sign in with Apple. REQUIRED by App Review 4.8 once Google Sign-In ships:
	     an app offering a third-party/social login must also offer a login service
	     that limits collection to name + email, lets the user keep their address
	     private, and does not track them for advertising. Mirrors ios.entitlements. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
